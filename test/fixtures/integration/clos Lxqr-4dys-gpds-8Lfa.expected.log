    public class StatefulPuzzle {
        private int x = 0;

        public void run() {
            onClick(() -> {
                x++;
                System.out.println("x=" + x);
            });

            onClick(() -> {
                if (x < 2) {
                    System.out.println("Hi!");
                }
            });

            if (x > 1) {
                onClick(() -> {
                    System.out.println("Bye!");
                });
            }

            System.out.println("End of run()");
        }
    }

